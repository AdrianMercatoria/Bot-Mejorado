DISCORD_TOKEN=tu_token_aqui
CLIENT_ID=tu_client_id_aqui

# GUILD_ID es opcional.
# Si lo configuras, los slash commands se registran solo en ese servidor y aparecen de inmediato (ideal para pruebas).
# Si lo omites, los comandos se registran de forma global y pueden tardar hasta 1 hora en propagarse.
GUILD_ID=tu_guild_id_aqui
