DISCORD_TOKEN=tu_token_aqui
CLIENT_ID=tu_client_id_aqui

# GUILD_ID es opcional.
# Si lo configuras, los slash commands se registran solo en ese servidor y aparecen de inmediato (ideal para pruebas).
# Si lo omites, los comandos se registran de forma global y pueden tardar hasta 1 hora en propagarse.
GUILD_ID=tu_guild_id_aqui

# DATA_DIR es opcional pero MUY recomendado.
# Carpeta donde el bot guarda su base de datos (state.json y su respaldo).
# Si lo dejas vacio, usa la carpeta "data" DENTRO del proyecto: al reemplazar
# la carpeta del bot para actualizar, se borran los datos.
# Apunta a una ruta FUERA del proyecto para conservarlos entre actualizaciones.
# Ejemplo Windows: DATA_DIR=C:\BotMejoradoDatos
# Ejemplo Linux:   DATA_DIR=/var/lib/bot-mejorado
DATA_DIR=
